VITE_API_URL=https://daratilback.onrender.com/api

VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Set to false if backend WebSocket auth is not ready.
VITE_WS_ENABLED=true

# Browser WebSocket cannot send Authorization headers.
# Use "cookie" only if backend authenticates /api/ws by cookie.
# Use "query" only if backend accepts /api/ws?token=...
VITE_WS_AUTH_MODE=query

# Optional. If omitted, frontend derives it from VITE_API_URL:
# https://host/api -> wss://host/api/ws
# VITE_WS_URL=wss://daratilback.onrender.com/api/ws
